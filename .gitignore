# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# 数据库与运行时产物
*.db
*.db-wal
*.db-shm

# 环境与凭证（严禁入库）
.env
.env.*
*.pem
*.key

# 文档创作草稿（飞书 lark-cli 工作目录）
draft_*/

# 工作区记忆（AI 助手内部状态，不进版本库）
.workbuddy/

# Node/客户端依赖产物
node_modules/
client/dist/
client/coverage/
*.tsbuildinfo
# 便携版 PostgreSQL（SP2-8 PG 压测环境，用完即删）
.pg/

# 飞书文档本地同步缓存（飞书为准，缓存不入库）
.feishu-docs/

# 验收证据本地归档（逐题 JSON/报告/探针输出，不入库，见 SP1-7 交付报告）
docs/acceptance/
# 飞书文档本地缓存的分析副本（正文由 .feishu-docs/sync-all 拉取，不入库）
docs/feishu-*/
# 注：这里刻意不写整目录 `docs/`。2026-10-11 文档审计发现宽忽略会让"交付物被静默漏掉"：
# 放在 docs/ 下的任何非证据文件都不会进版本库，也没有任何提示。新增需入库的 docs 内容时
# 直接 git add 即可；确属本机证据/缓存的再往上面两条规则里放。

# Personal Trilium notes and local note databases are not project deliverables.
/trilium/
/Trilium/
/trilium-data/
/trilium-notes/
/Trilium笔记/
