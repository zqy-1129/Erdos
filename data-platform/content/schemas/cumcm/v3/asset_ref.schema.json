{
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^asset-[0-9a-f]{64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "asset_id",
    "version",
    "sha256"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://erdos.local/content/schemas/cumcm/v3/asset_ref.schema.json"
}
