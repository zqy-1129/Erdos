{
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "node_type": {
      "enum": [
        "heading",
        "paragraph",
        "equation",
        "figure",
        "table",
        "reference",
        "appendix"
      ]
    },
    "subproblem_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "latex": {
          "type": "string"
        },
        "asset_ref": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^asset-[0-9a-f]{64}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "asset_id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "caption": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "node_id",
    "task_id",
    "order",
    "node_type",
    "content",
    "result_refs",
    "release_id",
    "version"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://erdos.local/content/schemas/cumcm/v3/document_node.schema.json"
}
