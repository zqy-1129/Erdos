{
  "type": "object",
  "properties": {
    "subproblem_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "problem_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4000
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4000
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8000
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "required": [
        "source_sha256",
        "page",
        "quote"
      ],
      "additionalProperties": false
    },
    "semantic_status": {
      "enum": [
        "candidate",
        "source_checked",
        "verified",
        "rejected",
        "abstained"
      ]
    }
  },
  "required": [
    "subproblem_id",
    "problem_id",
    "ordinal",
    "goal",
    "constraints",
    "deliverables",
    "dependencies",
    "evidence",
    "semantic_status"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
