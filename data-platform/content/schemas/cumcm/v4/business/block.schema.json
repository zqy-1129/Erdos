{
  "type": "object",
  "properties": {
    "block_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "coordinates": {
      "const": "pdf_points_bottom_left"
    },
    "extraction_method": {
      "enum": [
        "pdf_text",
        "ocr"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "semantic_status": {
      "enum": [
        "candidate",
        "source_checked",
        "verified",
        "rejected",
        "abstained"
      ]
    }
  },
  "required": [
    "block_id",
    "source_sha256",
    "page",
    "order",
    "text",
    "bbox",
    "coordinates",
    "extraction_method",
    "confidence",
    "semantic_status"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
