{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://erdos.local/content/schemas/cumcm/v2/figure_recipe.schema.json",
  "title": "Erdos cumcm v2 图表方案（figure_recipe）",
  "type": "object",
  "required": ["recipe_id", "competition_id", "version", "figure_type", "purpose", "stage", "required_inputs", "generation_conditions", "output_formats", "evidence"],
  "properties": {
    "recipe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "competition_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "schema_version": {"type": "integer"},
    "figure_type": {"type": "string"},
    "purpose": {"type": "string"},
    "stage": {"type": "string"},
    "required_inputs": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "optional_inputs": {"type": "array", "items": {"type": "object"}},
    "generation_conditions": {"type": "string"},
    "skip_conditions": {"type": "string"},
    "axis_spec": {"type": "object"},
    "legend_spec": {"type": "string"},
    "caption_spec": {"type": "string"},
    "style_ref": {"type": "object"},
    "output_formats": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "data_status": {"type": "string", "enum": ["current_task", "historical_reference", "estimated_from_image"]},
    "review_status": {"type": "string", "enum": ["pending_review", "approved", "rejected", "unknown"]}
  },
  "additionalProperties": false
}
