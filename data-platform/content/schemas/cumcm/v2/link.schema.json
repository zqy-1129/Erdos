{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://erdos.local/content/schemas/cumcm/v2/link.schema.json",
  "title": "Erdos cumcm v2 内容块-小问关联（block_subproblem_link）",
  "type": "object",
  "required": ["link_id", "block_id", "subproblem_id", "role", "relation_status", "evidence"],
  "properties": {
    "link_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "block_id": {"type": "string"},
    "subproblem_id": {"type": "string"},
    "role": {"type": "string", "enum": ["analysis", "assumptions", "symbols", "model", "algorithm", "results", "validation", "sensitivity", "discussion", "abstract", "references", "appendix"]},
    "relation_status": {"type": "string", "enum": ["candidate", "confirmed", "rejected"]},
    "evidence": {"type": "object"},
    "review_status": {"type": "string", "enum": ["pending_review", "approved", "rejected", "unknown"]}
  },
  "additionalProperties": false
}
