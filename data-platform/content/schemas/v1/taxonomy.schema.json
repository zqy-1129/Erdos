{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://erdos.local/content/schemas/v1/taxonomy.schema.json",
  "title": "Erdos 题型/方法/数据/领域分层分类规范 Schema v1",
  "description": "校验 config/taxonomy_v1.json：六类工作题型 + unknown，方法/数据/领域分层。",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "problem_types",
    "method_tags",
    "data_tags",
    "domain_tags",
    "label_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "taxonomy_v1"
    },
    "description": {
      "type": "string"
    },
    "working_classification_note": {
      "type": "string"
    },
    "problem_types": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name_zh"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "optimization",
              "prediction",
              "evaluation",
              "mechanism",
              "classification",
              "statistical_analysis",
              "unknown"
            ]
          },
          "name_zh": {
            "type": "string"
          },
          "name_en": {
            "type": [
              "string",
              "null"
            ]
          },
          "goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "boundary": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "method_tag_dictionary_ref": {
      "type": "string"
    },
    "method_tags": {
      "type": "object",
      "required": [
        "categories",
        "entries"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category_code",
              "codes"
            ],
            "properties": {
              "category_code": {
                "type": "string"
              },
              "name_zh": {
                "type": "string"
              },
              "codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "name_zh": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "legacy_tag": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "name_zh",
              "aliases",
              "legacy_tag"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": false
        }
      }
    },
    "data_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          }
        }
      }
    },
    "domain_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          }
        }
      }
    },
    "label_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": true
}
