{
  "schema_version": 1,
  "kind": "taxonomy_v1",
  "description": "十九赛事检索用工作分类。problem_types 是『工作分类』而非官方题型断言；method_tags/data_tags/domain_tags 分层，一题多标签、子问题独立标注。方法词表权威来源为 config/method_tags_v0.yaml，此处保留稳定 code/别名映射用于跨记录引用与校验。",
  "working_classification_note": "engine_regression_category 是回归分布用标签，不作为分类金标准。",
  "problem_types": [
    {
      "code": "optimization",
      "name_zh": "优化",
      "name_en": "optimization",
      "goal": "在约束下求目标函数最优（最大化/最小化），并给出决策方案",
      "boundary": "区分于单纯描述机理或预测；需有明确目标、决策变量与约束",
      "criteria": [
        "出现目标函数与约束条件",
        "要求求最优解或可行动作",
        "决策变量可枚举/连续"
      ]
    },
    {
      "code": "prediction",
      "name_zh": "预测",
      "name_en": "prediction",
      "goal": "用历史/观测数据对未来或未知量做推断",
      "boundary": "区分于机理推导；以数据驱动或时序外推为主",
      "criteria": [
        "有时间序列或样本数据",
        "要求给出未来值/区间/概率",
        "强调误差/不确定性"
      ]
    },
    {
      "code": "evaluation",
      "name_zh": "评价决策",
      "name_en": "evaluation",
      "goal": "对多个候选做排序/评分/择优或多个因素综合评判",
      "boundary": "区分于优化（通常无连续决策变量，以排序/权重为主）",
      "criteria": [
        "多指标打分/排序",
        "层次/权重/综合评分",
        "要求给出结论或排名"
      ]
    },
    {
      "code": "mechanism",
      "name_zh": "机理",
      "name_en": "mechanism",
      "goal": "建立描述物理/生物/传播等过程的方程或模型",
      "boundary": "区分于纯数据预测；需体现因果关系或守恒/动力学",
      "criteria": [
        "微分/差分方程或动力学过程",
        "因果关系或守恒律",
        "仿真/数值求解过程"
      ]
    },
    {
      "code": "classification",
      "name_zh": "分类识别",
      "name_en": "classification",
      "goal": "把对象归入若干已知类别并评估命中率",
      "boundary": "区分于评价（标签已知、以判别准确率为目标）",
      "criteria": [
        "有类别标签",
        "要求识别/判别",
        "混淆矩阵/准确率"
      ]
    },
    {
      "code": "statistical_analysis",
      "name_zh": "统计分析",
      "name_en": "statistical_analysis",
      "goal": "对数据进行描述、检验、相关性/差异分析",
      "boundary": "区分于机理与预测；以统计推断为核心产出",
      "criteria": [
        "假设检验/方差/相关",
        "分布/显著性结论",
        "不承诺预测未来"
      ]
    },
    {
      "code": "unknown",
      "name_zh": "待判定",
      "name_en": "unknown",
      "goal": null,
      "boundary": "尚不足以判定的工作类别",
      "criteria": []
    }
  ],
  "method_tag_dictionary_ref": "config/method_tags_v0.yaml",
